# ape-groom configuration. Copy to .env and edit.
# NEVER commit a real .env or a real keypair file. Both are gitignored.

# Which cluster to groom: localnet | devnet | testnet
# Mainnet is deliberately not an option and the agent refuses it at startup.
APE_CLUSTER=devnet

# Optional: an explicit RPC endpoint, which wins over APE_CLUSTER.
# APE_RPC_URL=http://127.0.0.1:8899

# Path to the wallet keypair: a JSON array of bytes, the format solana-keygen writes.
# Keep this OUTSIDE the repository. Generate a throwaway devnet wallet with:
#   solana-keygen new --no-bip39-passphrase -o ~/.config/solana/ape-devnet.json
APE_KEYPAIR=~/.config/solana/ape-devnet.json

# The agent only ever signs when this is exactly "true" AND you also pass --execute.
# Leave it unset to keep every run a dry run.
APE_EXECUTE=false

# Where the run journal and the agent's memory are kept.
APE_STATE_DIR=./.ape

# Optional policy overrides as JSON. Anything omitted keeps its default.
#   minReclaimLamports  ignore accounts holding less rent than this   (default 0)
#   maxAccountsPerRun   cap on accounts touched per run               (default 24)
#   batchSize           close instructions per transaction            (default 12)
#   includeWrappedSol   also close wrapped-SOL accounts               (default false)
#   protectedMints      mints the agent must never close              (default [])
#   recurrenceLimit     closes before a mint is quarantined           (default 3)
#   requireNetGain      refuse to act when fees exceed the rent       (default true)
# APE_POLICY={"batchSize":8,"protectedMints":["So11111111111111111111111111111111111111112"]}
